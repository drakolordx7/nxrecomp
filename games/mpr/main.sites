# Hook sites in Metroid Prime Remastered's `main` (v1.0.0), passed to the lifter with --sites.
# Addresses are guest addresses: main base 0x7100000000 + the offset in the binary (docs/mpr/hooks.md).
# Entry hooks are marked noinline by the lifter so the runtime can intercept every call.
#   0x3c81c8  CGameArchitectureSupport::Update(float*): once per rendered game frame (frame boundary, timestep)
#   0xc70334  CPlayerMP1::ProcessInput(CFinalInput const&, CStateManager&): player input (state probes, mouse aim)
entryhook 0x71003c81c8
entryhook 0x7100c70334
# S11 (high refresh rate, branch hifps; runtime src/timestep, docs/S11.md): real-time dt for the game step.
#   Update() hard-codes 1/60 in four places and a 14 ms background-work budget in four more; the runtime sets those registers from the
#   frame time (entry hook above: measures the frame; these mid hooks load the value into the register the next instruction reads).
midhook 0x71003c8238     # Update: w8 = 1/60, elapsed-time clamp (fmov s0,w8)
midhook 0x71003c830c     # Update: w27 = 1/60 for the whole loop (tick, accumulator compare, input dt, TimerTick dt, render-state sum)
midhook 0x71003c8354     # Update: w8 = -1/60, accumulator floor (fmov s1,w8 follows)
midhook 0x71003c8634     # Update: w8 = 0.014, extra-processing budget, first compare
midhook 0x71003c8648     # Update: w8 = 0.014, budget remaining for ExtraProcessingTick
midhook 0x71003c86f4     # Update: w8 = 0.014, second compare
midhook 0x71003c8708     # Update: w8 = 0.014, budget for ProcessGraveyard
#   per-tick friction constant of the in-air walk branch (the community 120/240 fps patch rewrites the same fmov): s1 = 3.5 per 1/60 s
midhook 0x7100cee3ec     # CPlayerMP1::GetDampedClampedVelocityWR: s1 = 3.5, fmul s8,s0,s1 follows
#   render timings: a frame counter / 60 (texture scroll, UV animation, water); advanced by the frame time instead of by 1
entryhook 0x7100c32890   # NRenderUtilMPT::TickRenderTimings (handled by the runtime)
#   texture streaming ages entries by a per-frame 1/60 (1/30 on the 30 fps path)
midhook 0x71000fe268     # CGraphicsServerDevice::BeginTargetFrame: w8 = 1/60 (fmov s0,w8)
midhook 0x71000fe274     # ... w8 = 1/30 (fmov s1,w8)
midhook 0x71000ff2fc     # CGraphicsServerDevice::TickMainThreadMaintenance: w9 = 1/60 (fmov s0,w9)
midhook 0x71000ff308     # ... w9 = 1/30 (fmov s1,w9)
#   movies: the clock of the movie player is the delta of CMovieList::Update(float); give it real elapsed time (audio plays in real time)
entryhook 0x71003669ec   # CMovieList::Update(float): s0 = delta seconds
# S10 (display options, branch display; runtime src/gfx/play/play_display.cpp, docs/S10.md): resolution, aspect ratio, HUD proportions, FOV, post effects.
#   COsContext::GetScreenWidth / GetScreenHeight (docked render size; the handheld getters stay: the touch screen maps through them)
entryhook 0x7100001248
entryhook 0x7100001250
#   CDynamicResolutionControl::GetResolutionScale (called once per frame by CGameRenderJob::RenderGamePass): 1.0 = dynamic resolution off
entryhook 0x71003c08a0
#   CDisplayManager::UpdateCameraNodes: the world projection takes its aspect from [[this + 16] + 152]; written before the original runs
entryhook 0x7100afe41c
#   CGuiCamera::GetProjectionState: every GUIF frame (HUD, menus, title) goes through it; a 16:9 camera is widened to the display aspect
entryhook 0x7100bd52fc
#   CGameCamera::GetVerticalFOV: the vertical field of view in radians; the FOV offset is added
entryhook 0x71004c2998
#   CRenderPass_Bloom::Render (skipped when bloom is off) and CRenderPass_ChromaticAberration::Render (strength zeroed when off)
entryhook 0x71003a450c
entryhook 0x71003a69b0
#   CUIDisplayManager::UpdateCameraNodes: the front end (title, menus) draws its 2D UI through the "UIOrthoCamera" scene node of this manager, authored for 16:9
entryhook 0x7100b0e5ec
# S14 (display extras, branch extras; runtime src/gfx/extras, docs/S14.md): HDR output.
#   NTonemap::build_tonemap_eval_params(STonemapParams const&): writes the 80-byte tone-curve block (exposure, toe, linear, shoulder, LUT scale) the
#   tone-map shader reads, through x8; the runtime runs it and then moves the shoulder's asymptote to the display's peak
entryhook 0x7100211c60
# S13 (verify; runtime src/gfx/play/play_camlook.cpp, docs/S13.md): mouse look that moves a camera and not the body. After the game's own Think the
# camera transform is turned: free look about the eye (first person, Alt held), the morph ball camera orbited about the ball.
entryhook 0x7100d72314   # CFirstPersonCameraMP1::Think(float, CStateManager&): x0 = the camera
entryhook 0x7100cff7ec   # CBallCameraMP1::Think(float, CStateManager&): x0 = the camera
#   CPlayerStuckTrackerMP1::AddState (S25): one sample per 1/60 s of game time, so the 20 sample window of the stuck test keeps its length at high frame rates
entryhook 0x7100d801d8
# S28 (mouse pointer in menus, branch mouse; runtime src/gfx/play/menu_mouse*.cpp, docs/S28.md): the front end's UI widgets take the pointer.
#   CUIWidgetGOC::ProcessInput(CStateManager&, float): x0 = widget; the hook runs the game's own and, when the pad did nothing for this widget, looks at the pointer
entryhook 0x710088cb74
#   CFinalInput::GetTouchScreenPosition(CTransform4f const*): answers the pointer position (UI units) while the game's touch routine runs for a click
entryhook 0x710035322c
#   CUIMenuGOC::BeforeThink(CStateManager&, float): x0 = the menu; before it runs its widgets the pointer picks the one it means
entryhook 0x7100888608
#   CGuiFrame::ProcessControllerInput(NGuiUtils::SWidgetInput const&): the older GUI frames (pause screen, options, map, message boxes): the pointer selects table rows
entryhook 0x7100bd45e0
#   CPauseScreenManagerMP1::ProcessControllerInput: x0 = the manager, which holds the tab and button labels of the pause screen (clicked like the buttons they show)
entryhook 0x7100e65bec
# S32 (freelock; runtime src/gfx/play/play_lockcam.cpp, docs/S32.md): free lock-on and the decoupled gun.
#   CPlayerMP1::UpdateOrbitOrientation(float, CStateManager&): x0 = the player; turns the body to face the lock-on target (skipped by free lock-on)
entryhook 0x7100c77854
#   CPlayerMP1::ComputeFreeLook(CFinalInput const&, CStateManager const&): x0 = the player; with a lock the pitch target is the direction to the target
entryhook 0x7100c71638
#   CPlayerMP1::TurnInput(CStateManager const&, CFinalInput const&) const: x0 = the player; returns the turn input in s0 (zero while locked on)
entryhook 0x7100cefa54
#   CFirstPersonCameraMP1::UpdateTransform(CStateManager&, float): x0 = the camera; while locked on it eases its own view toward the target (run as unlocked by free lock-on)
entryhook 0x7100d710ac
#   CPlayerMP1::ValidateCurrentOrbitTargetId(CStateManager&): x0 = the player; returns why the lock breaks (5 = the view turned away); free lock-on turns that into "still locked"
entryhook 0x7100c765d0
#   CPlayerGunMP1::Update(IMP1EntityBaseGOC&, float, float, float, CStateManager&): x0 = the gun; the decoupled gun moves its transform (+484) by the camera bob that the view no longer shows
entryhook 0x7100c93950
#   CPlayerMP1::UpdateAimTarget(CStateManager&): x0 = the player; free lock-on makes the locked target the aim target too, so the aiming cursor and the gun stay on it
entryhook 0x7100c7ad8c
#   CAimingCursorMP1::Update(CFinalInput const&, float, CStateManager&): x0 = the cursor; free lock-on follows what the cursor does while locked on
entryhook 0x7100cb6250
#   CCommandFrame::GetDigitalHeldInput(CDataEnumValue const&, CFinalInput const&, EFilterMode) const: free lock-on tells the aiming cursor that the aim-follow command is held while the lock is on
entryhook 0x71004d7540
# S42 (crashes, branch crashes; runtime src/gfx/play/play_scenefix.cpp, docs/S42.md): a ModCon scene node can be in a render list before its model
# data is loaded; the decal render queries then read its bounds through a null pointer (CFrustumPlanes::BoxInFrustumPlanes on address 0x190).
#   CModConSceneNode::ProcessRenderQuery(CSceneRenderQuery const&, CSceneRenderQueryResult&): x0 = node; skipped while the node's data is not loaded
entryhook 0x71001b57ac
#   CModConSceneNodeMP1::ProcessRenderQuery (the override the game's nodes use): the same
entryhook 0x7100fba8b8
# S46 (fastboot; runtime games/mpr/mpr_fastboot.cpp, docs/S46.md): optional start-up and menu tweaks ([tweaks] in controls.ini), all off by default.
#   CCommandFrame::GetDigitalPressedInput(CDataEnumValue const&, CFinalInput const&, EFilterMode) const: skip_intro answers "pressed" for the skip command at
#   its two cutscene-skip call sites (return addresses 0xe51e78 in CGameIOWinMP1::UserInput, 0x4bd840 in CCameraManager::CheckForCinematicSkip)
entryhook 0x71004d71f0
#   CGameState::IsCinematicSkippable(CGuid const&) const: skip_intro makes the opening cutscene skippable (what mCinematicForceSkippableOverride does for all)
entryhook 0x710040a2dc
#   CStreamedMovieGOC::Think(CStateManager&, float): x0 = the movie component; skip_boot_logos ends the title's intro movie with its own Skip(immediate)
entryhook 0x7100852b28
#   CFrontEndIOWin::TimerTick(CArchMsgParmTimerTick const&, CArchitectureQueue&) and NIOWinStateManagerUtils::UpdateStateManager(CStateManager&,
#   CArchMsgParmTimerTick const&): fast_menus hands the front end's state manager a longer step (x1 + 8, float)
entryhook 0x710041a21c
entryhook 0x710041b000
