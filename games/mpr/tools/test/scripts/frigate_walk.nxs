# From the game's first level frame: warp to the Frigate's first room, check where we are, walk forward and see that the player moves.
# Needs the lifted game built with runtime/tests/sites/mpr_testtools.sites and a game that has reached gameplay.
@timeout 1800
@warp frigate frigate_start
@shot frigate_start_00
@hash arrived
@assert health > 0
@assert area == frigate_start
hold LSTICK_UP
stick left 0 1.0 for 120
@shot frigate_start_walk
@assert speed >= 0
@pass
