# Hook sites in the `main` module of Hyrule Warriors: Age of Calamity, passed to the lifter with --sites. Generated by NX/addrs.py from recomp/addrs.tsv: edit that.
# Addresses are guest addresses: main base 0x7100000000 + the offset in the binary.
# M7 display (branch hwaoc-res; runtime/hwaoc_display.cpp): output and scene size, dynamic resolution, camera aspect (Hor+).
#   the KTGL device is created from a config on the stack ({1920, 1080, 3, 9, 5, interval 2, 9, 0, 1920, 1080, ...}): [0] [1] the display
#   (swapchain, vi layer, 2D layout) size, [8] [9] a second size pair (0 = the first)
entryhook 0x71017c5b60   # KTGL device create (x0 device, x1 config: u32 width, height, ..., [8] width, [9] height)
#   right after it the 3D scene's render size {1440, 810} is stored into the graphics system ([x20 + 0x368], x8 = height << 32 | width)
midhook 0x71008d9b14   # str x8, [x20, #0x368]: x8 = scene width | height << 32
#   dynamic resolution: the scene height in force (qword_2780B78, 567..810 docked) over 810.0 is the scene scale written to the view ([x9 + 0x11c]);
#   the hooks load 810 into s0 before the ucvtf so the scale stays 1.0 (the full scene size) unless [display] dynamic_resolution is on
midhook 0x710085d108   # ucvtf s0, s0 (s0 = the dynamic scene height)
midhook 0x710085e240   # ucvtf s0, s0 (the same in the second view setup)
#   KTGL camera projection: [cam + 320] near, [+324] far, [+328] vertical FOV (radians), [+332] aspect (16/9 from the camera defaults),
#   [+344] bit 0 orthographic, bit 1 reversed depth; writes the projection matrix at [cam + 192]
entryhook 0x71018a1080   # KTGL camera projection update (x0 camera)
