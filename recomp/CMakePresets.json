{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "clang-cl + Ninja (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cmake",
      "toolchainFile": "${sourceDir}/cmake/clang-cl.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" }
  ]
}
