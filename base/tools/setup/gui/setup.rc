// Resources for the setup program (<game>_setup.exe; names from CMakeLists.txt): manifest (Common Controls 6, per-monitor DPI, UTF-8, asInvoker) and version info.
#include <winres.h>

1 24 "setup.manifest"   // generated from setup.manifest.in in the build folder (CMakeLists.txt)

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", ""
            VALUE "FileDescription", NXS_RC_PRODUCT " - Setup"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", NXS_RC_EXE
            VALUE "OriginalFilename", NXS_RC_EXE ".exe"
            VALUE "ProductName", NXS_RC_PRODUCT " - Setup"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
