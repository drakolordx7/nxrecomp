# The setup window (nx_setup), included from tools/setup/CMakeLists.txt. SDL3 + Dear ImGui (base/ui, nxui): one program for Windows and Linux.
# NXS_GUI_SIM builds it against gui/sim_pipeline.cpp (fake progress) instead of the real core.
option(NXS_GUI_SIM "Build the GUI against gui/sim_pipeline.cpp (fake progress) instead of the real core" OFF)
set(_nxs_gui "${CMAKE_CURRENT_LIST_DIR}")
include("${_nxs_gui}/../../../ui/nxui.cmake")
set(_nxs_gui_main ${_nxs_gui}/main_ui.cpp)
set(_nxs_gui_srcs ${_nxs_gui_main})
if(NXS_GUI_SIM)
    list(APPEND _nxs_gui_srcs ${_nxs_gui}/sim_pipeline.cpp)
endif()
if(WIN32)
    add_executable(nx_setup WIN32 ${_nxs_gui_srcs} ${_nxs_gui}/setup.rc)
else()
    add_executable(nx_setup ${_nxs_gui_srcs})
endif()
if(NXS_GUI_SIM)
    target_link_libraries(nx_setup PRIVATE nxs_base nxs_game_hook)   # (the fake pipeline still reads the game hook through SetupOptions)
else()
    target_link_libraries(nx_setup PRIVATE nxs_core)
endif()
target_link_libraries(nx_setup PRIVATE nxui)
if(WIN32)
    target_link_options(nx_setup PRIVATE /ENTRY:mainCRTStartup)   # a GUI program with main(), not WinMain
endif()
target_compile_definitions(nx_setup PRIVATE _CRT_SECURE_NO_WARNINGS UNICODE _UNICODE)
target_compile_options(nx_setup PRIVATE ${NXS_WARN})
target_include_directories(nx_setup PRIVATE ${S})
if(WIN32)
    target_link_options(nx_setup PRIVATE /MANIFEST:NO)   # gui/setup.rc carries the manifest
    set_source_files_properties(${_nxs_gui}/setup.rc PROPERTIES COMPILE_DEFINITIONS "NXS_RC_EXE=\"${NXS_EXE}\";NXS_RC_PRODUCT=\"${NXS_PRODUCT}\""
        INCLUDE_DIRECTORIES "${CMAKE_BINARY_DIR}/generated" OBJECT_DEPENDS "${CMAKE_BINARY_DIR}/generated/setup.manifest")
endif()
set_target_properties(nx_setup PROPERTIES OUTPUT_NAME "${NXS_EXE}")
if(NOT NXS_GUI_SIM)
    foreach(isa avx2 sse4.1 sse2)
        add_custom_command(TARGET nx_setup POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E copy_if_different $<TARGET_FILE:astcdec-${isa}-shared> $<TARGET_FILE_DIR:nx_setup>)
    endforeach()
endif()
