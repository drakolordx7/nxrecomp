Ryujinx shader translator: implement the Maxwell PIXLD instruction (instruction emitter).
PIXLD.MY_INDEX returns the index of the sample the fragment shader invocation runs for; the NVN compiler puts it
in the epilogue of almost every pixel shader (33,361 of 33,744 pixel blocks of Metroid Prime Remastered). Ryujinx
logged "Pixld is not implemented" and left the destination register unwritten, which in SPIR-V is an undefined value.
Lowering: MY_INDEX reads gl_SampleID (BuiltIn SampleId; 0 when the pipeline is not multisampled), the other modes
(COVMASK, COVERED, OFFSET, CENTROID_OFFSET) write 0 and log. Applied at build time by translator/Ryujinx.Graphics.Shader.csproj to a
copy under the build folder; the checkout in third_party stays untouched. The Ryujinx code in the context lines is MIT.
--- a/Instructions/InstEmit.cs
+++ b/Instructions/InstEmit.cs
@@ -1,5 +1,7 @@
 using Ryujinx.Graphics.Shader.Decoders;
+using Ryujinx.Graphics.Shader.IntermediateRepresentation;
 using Ryujinx.Graphics.Shader.Translation;
+using static Ryujinx.Graphics.Shader.IntermediateRepresentation.OperandHelper;
 
 namespace Ryujinx.Graphics.Shader.Instructions
 {
@@ -196,9 +198,26 @@
 
         public static void Pixld(EmitterContext context)
         {
-            context.GetOp<InstPixld>();
-
-            context.TranslatorContext.GpuAccessor.Log("Shader instruction Pixld is not implemented.");
+            InstPixld op = context.GetOp<InstPixld>();
+
+            Operand value;
+
+            if (op.PixMode == PixMode.MyIndex && context.TranslatorContext.Definitions.Stage == ShaderStage.Fragment)
+            {
+                // The sample this invocation runs for (0 when the target is not multisampled).
+                value = context.Load(StorageKind.Input, IoVariable.SampleId);
+            }
+            else
+            {
+                if (op.PixMode != PixMode.MyIndex)
+                {
+                    context.TranslatorContext.GpuAccessor.Log($"Shader instruction Pixld.{op.PixMode} is approximated by 0.");
+                }
+
+                value = Const(0);
+            }
+
+            context.Copy(InstEmitHelper.GetDest(op.Dest), value);
         }
 
