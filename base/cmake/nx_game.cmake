# The game manifest, games/<id>/game.json: the one source of a game's names, ids, supported builds and modules. The recomp build
# (recomp/cmake/NxRecomp.cmake nxrecomp_add_game), the runtime (runtime/CMakeLists.txt NXRT_GAME_DIRS, cmake/game_exe.cmake
# nxrt_add_game_exe), the setup tool and the release script read it; nothing copies its values by hand.
#
#   nx_game_read(<game dir> <prefix>)        sets <prefix>_<FIELD> for the fields below, plus <prefix>_DIR (absolute game dir)
#   nx_game_header(<prefix> <out file>)      writes a C/C++ header with the same fields as NXGAME_<FIELD> macros
#                                            (the runtime's nxrt/game/identity.h turns them into the Info identity)
#
# Fields: ID TITLE PRODUCT SHORT_TITLE TITLE_ID VERSION (of the newest build) BUILD_IDS VERSIONS (lists, one per build) EXE SETUP SETUP_CLI
# LAUNCHER LAUNCHER_INI GAME_INI LOG SHADER_PACK SAVE_FOLDER RELEASE_PREFIX ENTRY_MODULE LANGUAGES (control.nacp SupportedLanguage as
# bits of services::Language: the manifest lists the names) SETUP_HOOK (absolute path of the game's
# setup CMake file, or empty) MODULES (names, in index order) and per module
# MODULE_<name>_FILE _INDEX _BASE _SHARDS _SITES (absolute, empty when none).
include_guard(GLOBAL)

# NX_ROOT: the main checkout (C:\nx): it holds the local-only data (games/<id>/game and work), build/, refs/ and wt/. Default: the parent
# of wt/ when this checkout is a worktree (NX/wt/<name>), else this checkout (the folder holding base/).
if(NOT DEFINED NX_ROOT OR NX_ROOT STREQUAL "")
    if(DEFINED ENV{NX_ROOT} AND NOT "$ENV{NX_ROOT}" STREQUAL "")
        file(TO_CMAKE_PATH "$ENV{NX_ROOT}" _nx_root)
    else()
        get_filename_component(_nx_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
        get_filename_component(_nx_up "${_nx_root}" DIRECTORY)
        get_filename_component(_nx_up_name "${_nx_up}" NAME)
        if(_nx_up_name STREQUAL "wt")
            get_filename_component(_nx_root "${_nx_up}" DIRECTORY)
        endif()
    endif()
    set(NX_ROOT "${_nx_root}" CACHE PATH "the main checkout (games/<id>/game and work, build/, wt/)")
endif()

# services::Language (runtime/include/nxrt/services.h), in enum order: bit n of a language mask is the n-th name.
set(_NX_LANGUAGE_NAMES Japanese AmericanEnglish French German Italian Spanish Chinese Korean Dutch Portuguese Russian Taiwanese BritishEnglish
    CanadianFrench LatinAmericanSpanish SimplifiedChinese TraditionalChinese BrazilianPortuguese)

function(_nx_json_get out json)
    string(JSON v ERROR_VARIABLE err GET "${json}" ${ARGN})
    if(err)
        set(v "")
    endif()
    set(${out} "${v}" PARENT_SCOPE)
endfunction()

function(nx_game_read dir prefix)
    get_filename_component(dir "${dir}" ABSOLUTE)
    set(file "${dir}/game.json")
    if(NOT EXISTS "${file}")
        message(FATAL_ERROR "nx_game_read: ${file} not found (a game folder holds its manifest game.json)")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
    file(READ "${file}" j)
    set(${prefix}_DIR "${dir}" PARENT_SCOPE)
    foreach(pair "ID;id" "TITLE;title" "PRODUCT;product" "SHORT_TITLE;short_title" "TITLE_ID;title_id" "SAVE_FOLDER;save_folder"
                 "ENTRY_MODULE;entry_module")
        list(GET pair 0 f)
        list(GET pair 1 k)
        _nx_json_get(v "${j}" ${k})
        set(${prefix}_${f} "${v}" PARENT_SCOPE)
        set(_${f} "${v}")
    endforeach()
    if(NOT _ID)
        message(FATAL_ERROR "nx_game_read: ${file} has no id")
    endif()
    foreach(pair "EXE;exe" "SETUP;setup" "SETUP_CLI;setup_cli" "LAUNCHER;launcher" "LAUNCHER_INI;launcher_ini" "GAME_INI;game_ini" "LOG;log"
                 "SHADER_PACK;shader_pack")
        list(GET pair 0 f)
        list(GET pair 1 k)
        _nx_json_get(v "${j}" files ${k})
        set(${prefix}_${f} "${v}" PARENT_SCOPE)
    endforeach()
    _nx_json_get(v "${j}" release prefix)
    set(${prefix}_RELEASE_PREFIX "${v}" PARENT_SCOPE)
    set(mask 0)
    string(JSON n ERROR_VARIABLE err LENGTH "${j}" languages)
    if(NOT err AND n GREATER 0)
        math(EXPR last "${n} - 1")
        foreach(i RANGE ${last})
            _nx_json_get(name "${j}" languages ${i})
            list(FIND _NX_LANGUAGE_NAMES "${name}" bit)
            if(bit LESS 0)
                message(FATAL_ERROR "nx_game_read: ${file}: unknown language '${name}' (names of services::Language)")
            endif()
            math(EXPR mask "${mask} | (1 << ${bit})")
        endforeach()
    endif()
    set(${prefix}_LANGUAGES "${mask}" PARENT_SCOPE)
    # setup_hook: the game's CMake file for its part of the setup tool (tools/setup/CMakeLists.txt); absolute, "" when the game has none
    _nx_json_get(v "${j}" setup_hook)
    if(v)
        set(v "${dir}/${v}")
    endif()
    set(${prefix}_SETUP_HOOK "${v}" PARENT_SCOPE)
    # builds
    set(ids "")
    set(vers "")
    string(JSON n ERROR_VARIABLE err LENGTH "${j}" builds)
    if(err OR n EQUAL 0)
        message(FATAL_ERROR "nx_game_read: ${file} lists no builds")
    endif()
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
        _nx_json_get(b "${j}" builds ${i} build_id)
        _nx_json_get(ver "${j}" builds ${i} version)
        list(APPEND ids "${b}")
        list(APPEND vers "${ver}")
    endforeach()
    set(${prefix}_BUILD_IDS "${ids}" PARENT_SCOPE)
    set(${prefix}_VERSIONS "${vers}" PARENT_SCOPE)
    set(${prefix}_VERSION "${ver}" PARENT_SCOPE)
    # modules
    set(mods "")
    string(JSON n ERROR_VARIABLE err LENGTH "${j}" modules)
    if(NOT err AND n GREATER 0)
        math(EXPR last "${n} - 1")
        foreach(i RANGE ${last})
            _nx_json_get(name "${j}" modules ${i} name)
            _nx_json_get(f "${j}" modules ${i} file)
            _nx_json_get(base "${j}" modules ${i} base)
            _nx_json_get(shards "${j}" modules ${i} shards)
            _nx_json_get(sites "${j}" modules ${i} sites)
            if(NOT f)
                set(f "${name}")
            endif()
            if(sites)
                set(sites "${dir}/${sites}")
            endif()
            list(APPEND mods "${name}")
            set(${prefix}_MODULE_${name}_FILE "${f}" PARENT_SCOPE)
            set(${prefix}_MODULE_${name}_INDEX "${i}" PARENT_SCOPE)
            set(${prefix}_MODULE_${name}_BASE "${base}" PARENT_SCOPE)
            set(${prefix}_MODULE_${name}_SHARDS "${shards}" PARENT_SCOPE)
            set(${prefix}_MODULE_${name}_SITES "${sites}" PARENT_SCOPE)
        endforeach()
    endif()
    set(${prefix}_MODULES "${mods}" PARENT_SCOPE)
endfunction()

function(nx_game_header prefix out)
    set(t "// Generated from ${${prefix}_DIR}/game.json by cmake/nx_game.cmake: edit the manifest, not this file.\n#pragma once\n")
    foreach(f ID TITLE PRODUCT SHORT_TITLE TITLE_ID VERSION EXE SETUP SETUP_CLI LAUNCHER LAUNCHER_INI GAME_INI LOG SHADER_PACK SAVE_FOLDER
              RELEASE_PREFIX ENTRY_MODULE)
        string(APPEND t "#define NXGAME_${f} \"${${prefix}_${f}}\"\n")
    endforeach()
    string(APPEND t "#define NXGAME_PROGRAM_ID 0x${${prefix}_TITLE_ID}ull\n")
    string(APPEND t "#define NXGAME_LANGUAGES ${${prefix}_LANGUAGES}u\n")
    # NXGAME_BUILDS: {"build id", "version"}, one row per supported build
    set(rows "")
    list(LENGTH ${prefix}_BUILD_IDS n)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
        list(GET ${prefix}_BUILD_IDS ${i} b)
        list(GET ${prefix}_VERSIONS ${i} v)
        string(APPEND rows "{\"${b}\", \"${v}\"}, ")
    endforeach()
    string(APPEND t "#define NXGAME_BUILDS ${rows}\n")
    file(CONFIGURE OUTPUT "${out}" CONTENT "${t}" @ONLY)
endfunction()
