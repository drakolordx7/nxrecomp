# nxui: the SDL3 + Dear ImGui shell of the programs with a window of their own (the launcher, the setup tool); one codebase, both systems.
# Include this file and link `nxui`. It uses the SDL3 and ImGui the including build already fetched (the runtime's cmake/gfx_deps.cmake) and
# otherwise fetches the same pinned versions itself (the setup tool is a project of its own): keep the pins in step with gfx_deps.cmake.
# Targets: nxui (the shell: window, renderer, fonts, theme, dialogs; links SDL3 static and ImGui with the SDL3 and SDL_Renderer backends).
if(TARGET nxui)
    return()
endif()
set(NXUI_DIR "${CMAKE_CURRENT_LIST_DIR}")
get_filename_component(NXUI_BASE_DIR "${NXUI_DIR}/.." ABSOLUTE)

if(NOT TARGET SDL3::SDL3-static OR NOT DEFINED imgui_SOURCE_DIR)
    include(FetchContent)
    if(NOT NXRT_DEPS_DIR)
        if(DEFINED NX_CACHE_DIR)
            set(_nxui_cache "${NX_CACHE_DIR}")
        elseif(WIN32)
            file(TO_CMAKE_PATH "$ENV{LOCALAPPDATA}/nxrt" _nxui_cache)
        elseif(DEFINED ENV{XDG_CACHE_HOME} AND NOT "$ENV{XDG_CACHE_HOME}" STREQUAL "")
            set(_nxui_cache "$ENV{XDG_CACHE_HOME}/nxrt")
        else()
            set(_nxui_cache "$ENV{HOME}/.cache/nxrt")
        endif()
        set(NXRT_DEPS_DIR "${_nxui_cache}/deps" CACHE PATH "Where the pinned third-party sources are downloaded to")
    endif()
    set(CMAKE_POLICY_DEFAULT_CMP0135 NEW)
    if(NOT TARGET SDL3::SDL3-static)
        FetchContent_Declare(sdl3
            URL https://github.com/libsdl-org/SDL/releases/download/release-3.4.18/SDL3-3.4.18.tar.gz
            DOWNLOAD_DIR "${NXRT_DEPS_DIR}"
            URL_HASH SHA256=9c75cf16330322c217dedd2e0609f1124f1b54b8633e763467b4684d0f4334a3)
        set(SDL_SHARED OFF CACHE BOOL "" FORCE)
        set(SDL_STATIC ON CACHE BOOL "" FORCE)
        set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
        set(SDL_TESTS OFF CACHE BOOL "" FORCE)
        set(SDL_EXAMPLES OFF CACHE BOOL "" FORCE)
        set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
        set(SDL_DISABLE_INSTALL ON CACHE BOOL "" FORCE)
        set(SDL_DISABLE_INSTALL_DOCS ON CACHE BOOL "" FORCE)
        set(SDL_VENDOR_INFO "nxrt" CACHE STRING "" FORCE)
        FetchContent_MakeAvailable(sdl3)
    endif()
    if(NOT DEFINED imgui_SOURCE_DIR)
        FetchContent_Declare(imgui
            URL https://github.com/ocornut/imgui/archive/refs/tags/v1.92.9b.zip
            DOWNLOAD_DIR "${NXRT_DEPS_DIR}"
            URL_HASH SHA256=e1c46d676c2bcb7ced847ba27f50553e33a19db97b3cadaec7f8be64449139f8
            SOURCE_SUBDIR none)
        FetchContent_MakeAvailable(imgui)
    endif()
endif()

# DejaVu Sans (the repository's font, runtime/assets/fonts) as a byte array, made at configure time.
set(_nxui_ttf "${NXUI_BASE_DIR}/runtime/assets/fonts/DejaVuSans.ttf")
set(_nxui_font_cpp "${CMAKE_BINARY_DIR}/nxui/nxui_font.cpp")
if(NOT EXISTS "${_nxui_font_cpp}" OR "${_nxui_ttf}" IS_NEWER_THAN "${_nxui_font_cpp}")
    file(READ "${_nxui_ttf}" _nxui_hex HEX)
    string(LENGTH "${_nxui_hex}" _nxui_hexlen)
    math(EXPR _nxui_size "${_nxui_hexlen} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _nxui_bytes "${_nxui_hex}")
    file(WRITE "${_nxui_font_cpp}"
        "// Generated by nxui.cmake from DejaVuSans.ttf (DejaVu fonts licence, runtime/assets/fonts/LICENSE-DejaVu.txt).\nextern const unsigned char nxui_font_dejavu[] = {${_nxui_bytes}};\nextern const unsigned long nxui_font_dejavu_size = ${_nxui_size}UL;\n")
    unset(_nxui_hex)
    unset(_nxui_bytes)
endif()

add_library(nxui STATIC
    "${NXUI_DIR}/src/ui.cpp" "${_nxui_font_cpp}"
    "${imgui_SOURCE_DIR}/imgui.cpp" "${imgui_SOURCE_DIR}/imgui_draw.cpp" "${imgui_SOURCE_DIR}/imgui_tables.cpp" "${imgui_SOURCE_DIR}/imgui_widgets.cpp"
    "${imgui_SOURCE_DIR}/misc/cpp/imgui_stdlib.cpp"
    "${imgui_SOURCE_DIR}/backends/imgui_impl_sdl3.cpp" "${imgui_SOURCE_DIR}/backends/imgui_impl_sdlrenderer3.cpp")
target_include_directories(nxui PUBLIC "${NXUI_DIR}/include")
target_include_directories(nxui SYSTEM PUBLIC "${imgui_SOURCE_DIR}" "${imgui_SOURCE_DIR}/backends" "${imgui_SOURCE_DIR}/misc/cpp")
target_compile_features(nxui PUBLIC cxx_std_20)
target_link_libraries(nxui PUBLIC SDL3::SDL3-static)
